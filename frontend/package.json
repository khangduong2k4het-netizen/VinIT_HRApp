{
  "name": "hra-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src",
    "type-check": "tsc --noEmit",
    "test:i18n": "node --test tests/i18n.test.cjs",
    "test:unit": "node --test tests/workspace-ui.test.cjs tests/synthetic-intake.test.cjs tests/local-drafts.test.cjs tests/work-queue-labels.test.cjs tests/criterion-action.test.cjs tests/criteria-generation.test.cjs tests/queue-contract.test.cjs tests/invalid-file-reason.test.cjs",
    "test:e2e:synthetic": "node tests/synthetic-ui.e2e.cjs",
    "test:e2e:accounts": "node tests/account-ui.e2e.cjs",
    "test:e2e:intake-mock": "node tests/intake-ui.e2e.cjs",
    "test:e2e:workflow-mock": "node tests/workflow-create-mock.e2e.cjs",
    "test:e2e:shortlist-mock": "node tests/shortlist-filter-mock.e2e.cjs && node tests/shortlist-workspace-mock.e2e.cjs",
    "test:e2e:applicants-mock": "node tests/applicants-large-list-mock.e2e.cjs",
    "test:e2e:a11y-mock": "node tests/a11y-mock.e2e.cjs",
    "test:e2e:ranking-context": "node tests/ranking-context-mock.e2e.cjs",
    "test:e2e:drafts-mock": "node tests/draft-back-guard-mock.e2e.cjs",
    "test:e2e:deadline-mock": "node tests/deadline-work-queue-mock.e2e.cjs",
    "test:e2e:ranking-compact": "node tests/ranking-compact-mock.e2e.cjs",
    "test:e2e:settings-mock": "node tests/settings-mock.e2e.cjs",
    "test:review-metrics": "node tests/review-metrics.cjs",
    "test:e2e:ux02-review": "node tests/ux02-review.e2e.cjs",
    "test:e2e:ux03-dashboard": "node tests/ux03-dashboard.e2e.cjs",
    "test:e2e:ux04-sticky-viewer": "node tests/ux04-sticky-viewer.e2e.cjs",
    "test:e2e:ux08-feedback": "node tests/ux08-feedback.e2e.cjs",
    "test:e2e:position-partial": "node tests/position-open-partial-failure.e2e.cjs"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/material-nextjs": "7.3.8",
    "axios": "^1.6.0",
    "next": "15.5.29",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "15.5.29",
    "playwright-core": "1.64.1",
    "postcss": "8.5.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
