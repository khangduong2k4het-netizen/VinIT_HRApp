# Docker Compose example. Copy to .env; never commit the filled file.
# Compose does NOT start Supabase, PostgreSQL or an LLM server.
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/v1

# Host-published ports stay private; Nginx exposes HTTPS on a VPS.
HRA_BACKEND_BIND=127.0.0.1
HRA_FRONTEND_BIND=127.0.0.1
# Required only with docker-compose.vps.yml: absolute host path to a verified
# database CA certificate, mounted read-only in the backend container.
HRA_DB_CA_PATH=/etc/vinit-hrapp/supabase-db-ca.crt

# Use a reachable Supabase PostgreSQL endpoint. Inside Docker, localhost means
# the backend container, not your host. Add sslmode=require for cloud.
DATABASE_URL=postgresql://postgres:CHANGE_ME@YOUR_DATABASE_HOST:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=5

# Supabase Auth and backend-only Storage credentials.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_BACKEND_ONLY_SERVICE_ROLE_KEY
# Only needed while legacy HS256 access tokens must still be accepted.
# Asymmetric tokens (ES256/RS256) are verified through Supabase JWKS.
SUPABASE_JWT_SECRET=

# Disabled by default; set a unique high-entropy setup token only while
# bootstrapping the first admin, then remove it from every backend instance.
ADMIN_BOOTSTRAP_TOKEN=

# local is only suitable for development; Compose persists it in a volume.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
SUPABASE_STORAGE_BUCKET_CV=cv-originals
SUPABASE_STORAGE_BUCKET_EXTRACTED=cv-extracted-text
MAX_FILE_SIZE_BYTES=10000000
MAX_FILES_PER_BATCH=50
MAX_BATCH_SIZE_BYTES=250000000

# F2.06 image OCR (JPG/PNG and images inside DOCX). Thresholds are proposals.
OCR_LANGUAGES=eng
OCR_MAX_IMAGE_PIXELS=16000000
OCR_MIN_DPI=150
OCR_MIN_SHARPNESS=20

# An OpenAI-compatible local endpoint, reachable from the backend process.
# localhost inside Docker is not the host; configure a private network address.
LLM_PROVIDER=local
LLM_PROVIDER_NAME=
LLM_MODEL_NAME=llama3.1:8b
LLM_API_BASE=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_TEMPERATURE_DEFAULT=0.1
# Optional: set only if the provider supports seed (determinism is best-effort).
LLM_SEED=
# Required only when an Admin saves an API key for an OpenAI Compatible
# provider in Admin > AI. Generate a Fernet key and keep it only in the
# backend environment; never commit or paste the generated value into Git.
# AI_CONFIG_ENCRYPTION_KEY=<generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
AI_CONFIG_ENCRYPTION_KEY=
# JSON arrays. The default model/endpoint above are automatically included.
# All API/worker instances must use consistent allowlists and secrets.
LLM_ALLOWED_MODELS=[]
LLM_ALLOWED_API_BASES=[]
ALLOW_EXTERNAL_API=false

MANDATORY_CRITERIA_WEIGHT_DEFAULT=0.7
NICE_TO_HAVE_WEIGHT_DEFAULT=0.3
MIN_EVIDENCE_COVERAGE=0.7
# Semantic retrieval/LTR are disabled by default. See doc/MATCHING_STABILITY.md
# before enabling; the hash embedding provider is only for local plumbing tests.
SEMANTIC_RETRIEVAL_ENABLED=false
EMBEDDING_PROVIDER=disabled
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_INDEX_VERSION=bge-index-v1
SEMANTIC_TOP_K=5
SEMANTIC_MIN_SIMILARITY=0.35
LTR_MODE=OFF
LTR_MODEL_PATH=
LTR_MODEL_VERSION=
LTR_MIN_NDCG_AT_10=0.70
LTR_MIN_PAIRWISE_ACCURACY=0.65
LTR_MIN_HOLDOUT_EXAMPLES=20
LTR_MIN_HOLDOUT_GROUPS=2
STRONG_MATCH_SCORE=100
MATCH_SCORE=80
NO_MATCH_SCORE=0
RETENTION_MONTHS=60

# F2.07 retention automation. The cycle never deletes data; keep it off until
# Legal & Privacy approves. Purge needs an OTP sent by email (SMTP below).
RETENTION_NOTICE_DAYS=[30,15,7]
RETENTION_SCHEDULER_ENABLED=false
RETENTION_SCHEDULER_INTERVAL_MINUTES=60
RETENTION_PURGE_REQUIRE_OTP=true
RETENTION_OTP_TTL_MINUTES=10
# Development/testing only: show the OTP in the UI when SMTP is not set.
RETENTION_OTP_DEV_ECHO=false
APP_PUBLIC_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Langfuse AI observability is optional, disabled by default and
# metadata-first. Keep CAPTURE_CONTENT=false; content capture is blocked in
# production by the backend and must only be considered for approved
# synthetic-data environments. Secrets belong only in the backend env.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_BASE_URL=
LANGFUSE_ENVIRONMENT=
LANGFUSE_RELEASE=
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_CAPTURE_CONTENT=false

# P3-3 public application portal (disabled until staging acceptance).
# Consent v4: one required checkbox covering this position and Talent Pool reuse.
# Deploy together with frontend CONSENT_NOTICE_VERSION=v4.
PUBLIC_INTAKE_ENABLED=false
PUBLIC_INTAKE_NOTICE_VERSION=v4
PUBLIC_INTAKE_IP_SALT=
PUBLIC_INTAKE_MAX_PER_IP_HOUR=5
# 1 only when a trusted nginx appends X-Forwarded-For in front of Next.js.
PUBLIC_INTAKE_TRUSTED_PROXY_HOPS=0
# Outside development/testing, enabling intake requires clamav, salt >=16 chars,
# and the actual trusted proxy hop count >=1. Scanner failure refuses uploads.
MALWARE_SCAN_MODE=off
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=10
# Pool reuse expires 60 months after consent, independently of position retention.
TALENT_POOL_RETENTION_MONTHS=60
TALENT_POOL_SCAN_MAX_CANDIDATES=200

# F3.03 partner candidate website (/v1/intake, header X-Intake-Key). Off by default;
# set true where a partner site is connected. Outside development/testing it needs MALWARE_SCAN_MODE=clamav.
INTAKE_API_ENABLED=false

# F3.05 candidate emails. record = HR's reviewed letter is only stored in the history (no email sent);
# smtp = sent through the SMTP_* settings. CANDIDATE_EMAIL_FROM is the shared recruiting mailbox
# (empty = SMTP_FROM, then the HR user's address); replies go to the HR user who sent it.
CANDIDATE_EMAIL_SEND_MODE=record
CANDIDATE_EMAIL_FROM=
CANDIDATE_EMAIL_MAX_PER_HOUR=100

# F3.03 email channel: Gmail recruiting mailbox. Gmail announces new mail on a Pub/Sub topic;
# HRA pulls the subscription (no public URL needed). See my_doc / setup guide for Google Cloud steps.
GMAIL_INTAKE_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/v1/mailbox/gmail/callback
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
GMAIL_FALLBACK_SYNC_MINUTES=10
FRONTEND_BASE_URL=http://localhost:3000
# Fernet key for the stored Gmail refresh token (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
MAILBOX_ENCRYPTION_KEY=
